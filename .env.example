# Copie para .env.local e preencha. NUNCA versione valores reais.

# Ambiente lógico da aplicação: development | staging | production
APP_ENV=development

# Supabase (projeto local via `supabase start` ou projeto de desenvolvimento)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Nunca exponha ao navegador nem use em componentes "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Testes de banco (Postgres local ou do CI). O usuário precisa poder criar bancos.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
