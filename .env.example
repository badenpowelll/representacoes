# Copie para .env.local e preencha. NUNCA versione valores reais.

# Ambiente lógico da aplicação: development | staging | production
APP_ENV=development

# Supabase (projeto local via `supabase start` ou projeto de desenvolvimento)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Nunca exponha ao navegador nem use em componentes "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Testes de banco (Postgres local ou do CI). O usuário precisa poder criar bancos.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Opcional, só para testes locais: servidor simulado da consulta de CNPJ (http://127.0.0.1:PORTA/).
# Ignorado fora de APP_ENV=development ou se não for localhost. Padrão: BrasilAPI (gratuita, sem chave).
CNPJ_API_BASE_URL=

# Envio de e-mail pelo sistema (Gmail da conta Google Workspace de cada usuário).
# Sem estas variáveis o envio fica em modo de teste: registra no histórico, mas não sai.
# App OAuth "Interno" criado pelo administrador do Workspace (gratuito). Escopo: gmail.send.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chave AES-256 (32 bytes em base64) para cifrar os refresh tokens: openssl rand -base64 32
EMAIL_TOKEN_KEY=
# "gmail" para envio real; qualquer outro valor (ou vazio) = modo de teste.
EMAIL_SENDING=
# URL pública do app (usada no retorno do OAuth). Ex.: https://seu-app.vercel.app
APP_URL=
# Opcional, só para testes locais: servidor simulado do Google (ignorado fora de APP_ENV=development/localhost).
GOOGLE_API_BASE_URL=
